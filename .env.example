# LLM (senaryo üretimi). Anthropic varsayılan; istersen başka sağlayıcıya çevir.
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5-20251001

# TTS sağlayıcı: "edge" (bedava) veya "elevenlabs"
TTS_PROVIDER=edge
ELEVENLABS_API_KEY=

# Rhubarb recognizer: Türkçe için "phonetic", İngilizce için "pocketSphinx"
RHUBARB_RECOGNIZER=phonetic

# Binary yolları (PATH'te değilse mutlak yol ver)
FFMPEG_BIN=ffmpeg
RHUBARB_BIN=rhubarb

# Publish — upload-post.com
UPLOAD_POST_API_KEY=
# Social account handles connected in upload-post.com dashboard
UPLOAD_POST_USERNAME_TIKTOK=@yourhandle
UPLOAD_POST_USERNAME_YOUTUBE=@yourhandle
UPLOAD_POST_USERNAME_INSTAGRAM=@yourhandle

# Monetizasyon: video açıklamasına eklenecek affiliate linki + çağrı metni
AFFILIATE_LINK=
AFFILIATE_CTA=👇 Beğendiysen kanala göz at
