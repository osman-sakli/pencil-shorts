# LLM (senaryo üretimi). Anthropic varsayılan; istersen başka sağlayıcıya çevir.
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5-20251001

# TTS sağlayıcı: "edge" (bedava) veya "elevenlabs"
TTS_PROVIDER=edge
ELEVENLABS_API_KEY=

# Rhubarb recognizer: Türkçe için "phonetic", İngilizce için "pocketSphinx"
RHUBARB_RECOGNIZER=phonetic

# Binary yolları (PATH'te değilse mutlak yol ver)
FFMPEG_BIN=ffmpeg
RHUBARB_BIN=rhubarb

# Publish — upload-post.com
UPLOAD_POST_API_KEY=
# Managed-user profile name from upload-post.com dashboard
UPLOAD_POST_USER=yourprofilename

# Monetizasyon: video açıklamasına eklenecek affiliate linki + çağrı metni
AFFILIATE_LINK=
AFFILIATE_CTA=👇 Beğendiysen kanala göz at

# TikTok retry ayarları (isteğe bağlı, varsayılanlar uygundur)
# TIKTOK_RETRIES=4          # kaç kez denensin
# TIKTOK_RETRY_WAIT=300     # inbox/hata durumunda kaç saniye beklensin (varsayılan: 5 dk)
# TIKTOK_CAP_WAIT=5400      # kota hatası durumunda kaç saniye beklensin (varsayılan: 90 dk)
FAL_KEY=
